{
  "private": true,
  "name": "locize-remix-i18next-example",
  "description": "Remix v2 + remix-i18next + Locize example. Translations are sync'd via locize-cli (build-time download), then served via i18next-fs-backend on the server and i18next-locize-backend on the client.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "remix build",
    "dev": "remix dev --manual",
    "start": "remix-serve ./build/index.js",
    "downloadLocales": "locize download --project-id=f6d74b76-9677-4a0d-b400-86e1507397ab --ver=latest --clean=true --path=./public/locales",
    "syncLocales": "locize sync --project-id=f6d74b76-9677-4a0d-b400-86e1507397ab --ver=latest --api-key=1c2bbc21-027d-4f41-995a-e8beb451cdef --path=./public/locales --dry=true"
  },
  "dependencies": {
    "@remix-run/node": "^2.17.4",
    "@remix-run/react": "^2.17.4",
    "@remix-run/serve": "^2.17.4",
    "i18next": "^23.16.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-fs-backend": "^2.6.5",
    "i18next-locize-backend": "^10.0.0",
    "isbot": "^5.1.32",
    "locize": "^4.0.23",
    "locize-lastused": "^5.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.7.4",
    "remix-i18next": "^6.4.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.4",
    "locize-cli": "^12.1.1"
  }
}
